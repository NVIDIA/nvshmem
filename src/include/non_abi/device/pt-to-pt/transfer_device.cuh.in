NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ void nvshmemi_transfer_amo_nonfetch(
    void *rptr, T value, int pe, nvshmemi_amo_t op, nvshmemx_qp_handle_t qp_index) {
    switch (nvshmemi_device_state_d.selected_device_transport) {
#ifdef NVSHMEM_IBGDA_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_IBGDA:
            nvshmemi_ibgda_amo_nonfetch<T>(rptr, value, pe, op, qp_index);
            break;
#endif
#ifdef NVSHMEM_GPUNETIO_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_GPUNETIO_GDAKI:
            nvshmemi_gdaki_amo_nonfetch<T>(rptr, value, pe, op, qp_index);
            break;
#endif
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_PROXY:
