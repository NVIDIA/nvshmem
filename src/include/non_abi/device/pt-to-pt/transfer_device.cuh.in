#define TRANSFER_REPT_FOR_STANDARD_RMA_TYPES(FN_TEMPLATE) \
    FN_TEMPLATE(char)                                     \
    FN_TEMPLATE(unsigned char)                            \
    FN_TEMPLATE(short)                                    \
    FN_TEMPLATE(unsigned short)                           \
    FN_TEMPLATE(int)                                      \
    FN_TEMPLATE(unsigned int)                             \
    FN_TEMPLATE(long)                                     \
    FN_TEMPLATE(unsigned long)                            \
    FN_TEMPLATE(long long)                                \
    FN_TEMPLATE(unsigned long long)                       \
    FN_TEMPLATE(float)                                    \
    FN_TEMPLATE(double)

#define TRANSFER_REPT_FOR_STANDARD_AMO_TYPES(FN_TEMPLATE) \
    FN_TEMPLATE(short)                                    \
    FN_TEMPLATE(unsigned short)                           \
    FN_TEMPLATE(int)                                      \
    FN_TEMPLATE(unsigned int)                             \
    FN_TEMPLATE(long)                                     \
    FN_TEMPLATE(unsigned long)                            \
    FN_TEMPLATE(long long)                                \
    FN_TEMPLATE(unsigned long long)

#define TRANSFER_REPT_FOR_EXTENDED_AMO_TYPES(FN_TEMPLATE) \
    FN_TEMPLATE(__half)                                   \
    FN_TEMPLATE(float)                                    \
    FN_TEMPLATE(double)

#define TRANSFER_REPT_FOR_ALL_SCOPES(FN_TEMPLATE) \
    FN_TEMPLATE(NVSHMEMI_THREADGROUP_THREAD)      \
    FN_TEMPLATE(NVSHMEMI_THREADGROUP_WARP)        \
    FN_TEMPLATE(NVSHMEMI_THREADGROUP_BLOCK)

#ifdef __CUDA_ARCH__
template <threadgroup_t SCOPE>
NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ bool
nvshmemi_transfer_submit_active_region_slow();

template <threadgroup_t SCOPE>
__device__ NVSHMEMI_DEVICE_ALWAYS_FORCE_INLINE bool nvshmemi_transfer_submit_active_region() {
    return nvshmemi_region_any_active() && nvshmemi_transfer_submit_active_region_slow<SCOPE>();
}

__device__ NVSHMEMI_TRANSFER_INLINE void nvshmemi_transfer_syncapi_update_mem() {
    __threadfence(); /* 1. Ensures consitency op is not called before the prior test/wait condition
                        has been met
                        2. Needed to prevent reorder of instructions after sync api (when the
                        following if condition is false) */
    if (nvshmemi_device_state_d.job_connectivity > NVSHMEMI_JOB_GPU_PROXY) {
        nvshmemi_transfer_enforce_consistency_at_target(true);
    }
}

template <typename T>
NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ void nvshmemi_transfer_rma_p(
    void *rptr, const T value, int pe, nvshmemx_qp_handle_t qp_index) {
    switch (nvshmemi_device_state_d.selected_device_transport) {
#ifdef NVSHMEM_IBGDA_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_IBGDA:
            nvshmemi_ibgda_rma_p<T>(rptr, value, pe, qp_index);
            break;
#endif
#ifdef NVSHMEM_GPUNETIO_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_GPUNETIO_GDAKI:
            nvshmemi_gdaki_rma_p<T>(rptr, value, pe, qp_index);
            break;
#endif
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_PROXY:
        default:
            nvshmemi_proxy_rma_p<T>(rptr, value, pe, qp_index);
            break;
    }
}

#define TRANSFER_DECL_RMA_P(Type)                                                                \
    template __device__ void nvshmemi_transfer_rma_p<Type>(void *rptr, const Type value, int pe, \
                                                           nvshmemx_qp_handle_t qp_index);

TRANSFER_REPT_FOR_STANDARD_RMA_TYPES(TRANSFER_DECL_RMA_P)

template <typename T>
NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ T
nvshmemi_transfer_rma_g(void *rptr, int pe, nvshmemx_qp_handle_t qp_index) {
    nvshmemi_transfer_submit_active_region<NVSHMEMI_THREADGROUP_THREAD>();
    switch (nvshmemi_device_state_d.selected_device_transport) {
#ifdef NVSHMEM_IBGDA_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_IBGDA:
            return nvshmemi_ibgda_rma_g<T>(rptr, pe, qp_index);
            break;
#endif
#ifdef NVSHMEM_GPUNETIO_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_GPUNETIO_GDAKI:
            return nvshmemi_gdaki_rma_g<T>(rptr, pe, qp_index);
            break;
#endif
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_PROXY:
        default:
            return nvshmemi_proxy_rma_g<T>(rptr, pe, qp_index);
            break;
    }
}

#define TRANSFER_DECL_RMA_G(Type)                                              \
    template __device__ Type nvshmemi_transfer_rma_g<Type>(void *rptr, int pe, \
                                                           nvshmemx_qp_handle_t qp_index);

TRANSFER_REPT_FOR_STANDARD_RMA_TYPES(TRANSFER_DECL_RMA_G)

template <threadgroup_t SCOPE, nvshmemi_op_t channel_op>
NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ void nvshmemi_transfer_rma(
    void *rptr, void *lptr, size_t bytes, int pe, nvshmemx_qp_handle_t qp_index) {
    nvshmemi_transfer_submit_active_region<SCOPE>();
    switch (nvshmemi_device_state_d.selected_device_transport) {
#ifdef NVSHMEM_IBGDA_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_IBGDA:
            nvshmemi_ibgda_rma<SCOPE, channel_op>(rptr, lptr, bytes, pe, qp_index);
            break;
#endif
#ifdef NVSHMEM_GPUNETIO_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_GPUNETIO_GDAKI:
            nvshmemi_gdaki_rma<SCOPE, channel_op>(rptr, lptr, bytes, pe, qp_index);
            break;
#endif
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_PROXY:
        default: {
            int myIdx = nvshmemi_thread_id_in_threadgroup<SCOPE>();
            if (!myIdx) {
                nvshmemi_proxy_rma_nbi(rptr, lptr, bytes, pe, channel_op, qp_index);
                nvshmemi_proxy_quiet(false, pe, &qp_index, 1);
                if (SCOPE == nvshmemi_threadgroup_thread)
                    __threadfence_block(); /* to prevent reuse of src buffer before quiet
                                    completion; for warp/block scope, following sync op will
                                    accomplish that */
            }
        }
    }
}

#define TRANSFER_DECL_RMA(SCOPE)                                                      \
    template __device__ void nvshmemi_transfer_rma<SCOPE, NVSHMEMI_OP_PUT>(           \
        void *rptr, void *lptr, size_t bytes, int pe, nvshmemx_qp_handle_t qp_index); \
    template __device__ void nvshmemi_transfer_rma<SCOPE, NVSHMEMI_OP_GET>(           \
        void *rptr, void *lptr, size_t bytes, int pe, nvshmemx_qp_handle_t qp_index);

TRANSFER_REPT_FOR_ALL_SCOPES(TRANSFER_DECL_RMA)

template <threadgroup_t SCOPE>
NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ void nvshmemi_transfer_put_signal(
    void *rptr, void *lptr, size_t bytes, void *sig_addr, uint64_t signal, nvshmemi_amo_t sig_op,
    int pe, bool is_nbi, nvshmemx_qp_handle_t qp_index) {
    if (!is_nbi) nvshmemi_transfer_submit_active_region<SCOPE>();
    switch (nvshmemi_device_state_d.selected_device_transport) {
#ifdef NVSHMEM_IBGDA_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_IBGDA:
            nvshmemi_ibgda_put_signal<SCOPE>(rptr, lptr, bytes, sig_addr, signal, sig_op, pe,
                                             is_nbi, qp_index);
            break;
#endif
#ifdef NVSHMEM_GPUNETIO_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_GPUNETIO_GDAKI:
            nvshmemi_gdaki_put_signal<SCOPE>(rptr, lptr, bytes, sig_addr, signal, sig_op, pe,
                                             is_nbi, qp_index);
            break;
#endif
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_PROXY:
        default: {
            int myIdx = nvshmemi_thread_id_in_threadgroup<SCOPE>();
            if (!myIdx) {
                nvshmemi_proxy_put_signal_nbi(rptr, lptr, bytes, pe, NVSHMEMI_OP_PUT_SIGNAL,
                                              sig_addr, signal, sig_op, qp_index);
                if (is_nbi == 0) {
                    nvshmemi_proxy_quiet(false, pe, &qp_index, 1);
                    if (SCOPE == nvshmemi_threadgroup_thread)
                        __threadfence_block(); /* to prevent reuse of src buffer before quiet
                                            completion for warp/block scope, following sync op will
                                            accomplish that
                                          */
                }
            }
        }
    }
}

#define TRANSFER_DECL_PUT_SIGNAL(SCOPE)                                        \
    template __device__ void nvshmemi_transfer_put_signal<SCOPE>(              \
        void *rptr, void *lptr, size_t bytes, void *sig_rptr, uint64_t signal, \
        nvshmemi_amo_t sig_op, int pe, bool is_nbi, nvshmemx_qp_handle_t qp_index);

TRANSFER_REPT_FOR_ALL_SCOPES(TRANSFER_DECL_PUT_SIGNAL)

template <threadgroup_t SCOPE, nvshmemi_op_t channel_op>
NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ void nvshmemi_transfer_rma_nbi(
    void *rptr, void *lptr, size_t bytes, int pe, nvshmemx_qp_handle_t qp_index,
    const nvshmemi_region_info_t *region_info) {
    switch (nvshmemi_device_state_d.selected_device_transport) {
#ifdef NVSHMEM_IBGDA_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_IBGDA:
            nvshmemi_ibgda_rma_nbi<SCOPE, channel_op>(rptr, lptr, bytes, pe, qp_index);
            break;
#endif
#ifdef NVSHMEM_GPUNETIO_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_GPUNETIO_GDAKI:
            nvshmemi_gdaki_rma_nbi<SCOPE, channel_op>(rptr, lptr, bytes, pe, qp_index);
            break;
#endif
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_PROXY:
        default: {
            int myIdx = nvshmemi_thread_id_in_threadgroup<SCOPE>();
            if (!myIdx)
                nvshmemi_proxy_rma_nbi(rptr, lptr, bytes, pe, channel_op, qp_index, region_info);
            break;
        }
    }
}

#define TRANSFER_DECL_RMA_NBI(SCOPE)                                                 \
    template __device__ void nvshmemi_transfer_rma_nbi<SCOPE, NVSHMEMI_OP_PUT>(      \
        void *rptr, void *lptr, size_t bytes, int pe, nvshmemx_qp_handle_t qp_index, \
        const nvshmemi_region_info_t *region_info);                                  \
    template __device__ void nvshmemi_transfer_rma_nbi<SCOPE, NVSHMEMI_OP_GET>(      \
        void *rptr, void *lptr, size_t bytes, int pe, nvshmemx_qp_handle_t qp_index, \
        const nvshmemi_region_info_t *region_info);

TRANSFER_REPT_FOR_ALL_SCOPES(TRANSFER_DECL_RMA_NBI)

template <threadgroup_t SCOPE>
NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ void nvshmemi_transfer_region_end(
    const nvshmemi_region_info_t *region_info) {
    int myIdx = nvshmemi_thread_id_in_threadgroup<SCOPE>();
    if (myIdx != 0 ||
        !nvshmemi_region_info_has_hints(region_info, NVSHMEMI_REGION_HINT_BATCH_RMA)) {
        return;
    }

    switch (nvshmemi_device_state_d.selected_device_transport) {
#ifdef NVSHMEM_IBGDA_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_IBGDA:
            break;
#endif
#ifdef NVSHMEM_GPUNETIO_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_GPUNETIO_GDAKI:
            break;
#endif
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_PROXY:
        default: {
            nvshmemi_proxy_region_end(region_info);
            break;
        }
    }
}

#define TRANSFER_DECL_REGION_END(SCOPE)                           \
    template __device__ void nvshmemi_transfer_region_end<SCOPE>( \
        const nvshmemi_region_info_t *region_info);

TRANSFER_REPT_FOR_ALL_SCOPES(TRANSFER_DECL_REGION_END)

template <threadgroup_t SCOPE>
NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ bool
nvshmemi_transfer_submit_active_region_slow() {
    nvshmemi_region_info_t region_info =
        nvshmemi_region_resolve_leader<SCOPE>(NVSHMEMI_REGION_SUPPORTED_HINTS);
    bool region_active = region_info.region_id != 0;
    if (region_active) {
        nvshmemi_transfer_region_end<SCOPE>(&region_info);
    }
    nvshmemi_threadgroup_sync<SCOPE>();
    return region_active;
}

template <typename T>
NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ T nvshmemi_transfer_amo_fetch(
    void *rptr, T value, T compare, int pe, nvshmemi_amo_t op, nvshmemx_qp_handle_t qp_index) {
    nvshmemi_transfer_submit_active_region<NVSHMEMI_THREADGROUP_THREAD>();
    switch (nvshmemi_device_state_d.selected_device_transport) {
#ifdef NVSHMEM_IBGDA_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_IBGDA:
            return nvshmemi_ibgda_amo_fetch<T>(rptr, value, compare, pe, op, qp_index);
#endif
#ifdef NVSHMEM_GPUNETIO_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_GPUNETIO_GDAKI:
            return nvshmemi_gdaki_amo_fetch<T>(rptr, value, compare, pe, op, qp_index);
#endif
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_PROXY:
        default: {
            T retval;
            nvshmemi_proxy_amo_fetch<T>(rptr, (void *)&retval, value, compare, pe, op, qp_index);
            return retval;
        }
    }
}

#define TRANSFER_DECL_AMO_FETCH(Type)                                                \
    template __device__ Type nvshmemi_transfer_amo_fetch<Type>(                      \
        void *rptr, const Type value, const Type compare, int pe, nvshmemi_amo_t op, \
        nvshmemx_qp_handle_t qp_index);

TRANSFER_REPT_FOR_STANDARD_AMO_TYPES(TRANSFER_DECL_AMO_FETCH);
TRANSFER_REPT_FOR_EXTENDED_AMO_TYPES(TRANSFER_DECL_AMO_FETCH);

