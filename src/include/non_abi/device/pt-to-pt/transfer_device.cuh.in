}

#define TRANSFER_DECL_AMO_NONFETCH(Type)                           \
    template __device__ void nvshmemi_transfer_amo_nonfetch<Type>( \
        void *rptr, const Type value, int pe, nvshmemi_amo_t op, nvshmemx_qp_handle_t qp_index);

TRANSFER_REPT_FOR_STANDARD_AMO_TYPES(TRANSFER_DECL_AMO_NONFETCH);
TRANSFER_REPT_FOR_EXTENDED_AMO_TYPES(TRANSFER_DECL_AMO_NONFETCH);

template <threadgroup_t SCOPE>
NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ void nvshmemi_transfer_quiet(
    bool use_membar, int pe_hint, nvshmemx_qp_handle_t *qp_handle, int num_qps) {
    // quiet_on_stream also shares this code path.
    int myIdx = nvshmemi_thread_id_in_threadgroup<SCOPE>();
    nvshmemi_transfer_submit_active_region<SCOPE>();

    switch (nvshmemi_device_state_d.selected_device_transport) {
#ifdef NVSHMEM_IBGDA_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_IBGDA:
            nvshmemi_ibgda_qp_quiet<SCOPE>(true, pe_hint, qp_handle, num_qps);
            if (use_membar) {
                if (!myIdx) {
                    __threadfence_system();
                }
            }
            break;
#endif
#ifdef NVSHMEM_GPUNETIO_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_GPUNETIO_GDAKI:
            nvshmemi_gdaki_qp_quiet<SCOPE>(true, pe_hint, qp_handle, num_qps);
            if (use_membar) {
                if (!myIdx) {
                    __threadfence_system();
                }
            }
            break;
#endif
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_PROXY:
        default:
            if (nvshmemi_device_state_d.proxy == NVSHMEMI_PROXY_FULL) {
                if (!myIdx) {
                    nvshmemi_proxy_quiet(use_membar, pe_hint, qp_handle, num_qps);
                }
            }
            break;
    }
    nvshmemi_threadgroup_sync<SCOPE>();
}

#define TRANSFER_DECL_QUIET(SCOPE)                           \
    template __device__ void nvshmemi_transfer_quiet<SCOPE>( \
        bool use_membar, int pe_hint, nvshmemx_qp_handle_t *qp_handle, int num_qps);

TRANSFER_REPT_FOR_ALL_SCOPES(TRANSFER_DECL_QUIET);
TRANSFER_DECL_QUIET(NVSHMEMI_THREADGROUP_WARPGROUP);
#undef TRANSFER_DECL_QUIET

template <threadgroup_t SCOPE>
NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE __device__ void nvshmemi_transfer_fence(
    int pe_hint, nvshmemx_qp_handle_t *qp_handle, int num_qps) {
    int myIdx = nvshmemi_thread_id_in_threadgroup<SCOPE>();
    bool region_active = nvshmemi_transfer_submit_active_region<SCOPE>();

    switch (nvshmemi_device_state_d.selected_device_transport) {
#ifdef NVSHMEM_IBGDA_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_IBGDA:
            nvshmemi_ibgda_qp_fence<SCOPE>(pe_hint, qp_handle, num_qps);
            break;
#endif
#ifdef NVSHMEM_GPUNETIO_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_GPUNETIO_GDAKI:
            nvshmemi_gdaki_qp_fence<SCOPE>(pe_hint, qp_handle, num_qps);
            break;
#endif
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_PROXY:
        default:
            if ((nvshmemi_device_state_d.proxy == NVSHMEMI_PROXY_FULL) &&
                (region_active || !nvshmemi_device_state_d.proxy_ops_are_ordered)) {
                if (!myIdx) {
                    nvshmemi_proxy_fence(pe_hint, qp_handle, num_qps);
                }
            }
            break;
    }
    nvshmemi_threadgroup_sync<SCOPE>();
}

#define TRANSFER_DECL_FENCE(SCOPE)                           \
    template __device__ void nvshmemi_transfer_fence<SCOPE>( \
        int pe_hint, nvshmemx_qp_handle_t *qp_handle, int num_qps);

TRANSFER_REPT_FOR_ALL_SCOPES(TRANSFER_DECL_FENCE);
#undef TRANSFER_DECL_FENCE

NVSHMEMI_TRANSFER_STATIC NVSHMEMI_TRANSFER_INLINE
    __device__ void nvshmemi_transfer_enforce_consistency_at_target(bool use_membar) {
    switch (nvshmemi_device_state_d.selected_device_transport) {
#ifdef NVSHMEM_IBGDA_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_IBGDA:
            nvshmemi_ibgda_enforce_consistency_at_target(use_membar);
            break;
#endif
#ifdef NVSHMEM_GPUNETIO_SUPPORT
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_GPUNETIO_GDAKI:
            nvshmemi_gdaki_enforce_consistency_at_target(use_membar);
            break;
#endif
        case NVSHMEMI_DEVICE_TRANSPORT_TYPE_PROXY:
        default:
            nvshmemi_proxy_enforce_consistency_at_target(use_membar);
            break;
    }
}
#endif /* __CUDA_ARCH__ */

#endif /* NVSHMEM_BUILD_P2P_ONLY */

#endif /* TRANSFER_DEVICE_CUH */
